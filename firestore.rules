rules_version = '2';

// =============================================================================
// Foray — Firestore security rules
//
// Source of truth for these rules. To deploy: paste into the Firebase console
// (Firestore Database → Rules → Publish), or `firebase deploy --only
// firestore:rules` once the Firebase CLI is configured.
//
// Model:
//   - CONTENT collections (cities, zones, maps, map_sets, challenges) are
//     readable by any signed-in user but writable ONLY by admin/GM. These hold
//     the game library and are edited from admin tools.
//   - GAMEPLAY collections (games and their subcollections, submissions) stay
//     writable by any signed-in user, because players legitimately write them
//     during a game (joining teams, submitting proof, messaging, etc.).
//   - users/{uid}: each user manages their own doc, BUT can never set or
//     change their own "role" field. New accounts must start as "player".
//     Roles are changed in the Firebase console (which bypasses these rules)
//     or by an admin/GM. This closes the hole where a player could write
//     role: "gm" to their own doc and unlock game creation + admin tools.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // True when the signed-in user's users/{uid} doc has role admin or gm.
    function isAdminOrGm() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'gm'];
    }

    function signedIn() {
      return request.auth != null;
    }

    // ---- Users: own doc only, and the role field is frozen -----------------
    match /users/{userId} {
      // You can read your own doc; admins/GMs can read anyone's.
      allow read: if (request.auth != null && request.auth.uid == userId)
        || isAdminOrGm();

      // Creating your own doc is fine, but it must start as role "player".
      // (This is exactly what the signup flow in AuthPage.tsx writes.)
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.get('role', 'player') == 'player';

      // Updating your own doc is fine (display name, stats, profile...),
      // but the role field must come out of the write unchanged.
      // Admins/GMs may update anyone (e.g. promoting a GM from a future
      // admin screen).
      allow update: if (
          request.auth != null
          && request.auth.uid == userId
          && request.resource.data.get('role', 'player') == resource.data.get('role', 'player')
        ) || isAdminOrGm();

      // Nobody deletes user docs from the app.
      allow delete: if false;
    }

    // ---- Content: read by any signed-in user, write only by admin/GM --------
    match /cities/{cityId} {
      allow read: if signedIn();
      allow write: if isAdminOrGm();
    }
    match /zones/{zoneId} {
      allow read: if signedIn();
      allow write: if isAdminOrGm();
    }
    match /maps/{mapId} {
      allow read: if signedIn();
      allow write: if isAdminOrGm();
    }
    match /map_sets/{setId} {
      allow read: if signedIn();
      allow write: if isAdminOrGm();
    }
    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if isAdminOrGm();
    }

    // ---- Gameplay: any signed-in user (players write these mid-game) --------
    match /games/{gameId} {
      allow read, update, delete: if signedIn();
      // Only Game Masters / admins can create a game. Players join via code.
      allow create: if isAdminOrGm();

      match /teams/{teamId} {
        allow read, write: if signedIn();

        match /sequential_progress/{progressId} {
          allow read, write: if signedIn();
        }
      }

      match /zone_scores/{scoreId} {
        allow read, write: if signedIn();
      }

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }

      match /events/{eventId} {
        allow read, write: if signedIn();
      }

      // Per-game zone snapshot, written once at game creation by the GM.
      match /zones/{zoneId} {
        allow read: if signedIn();
        allow write: if isAdminOrGm();
      }

      // Late-join requests (doc id = requesting player's uid). Players create
      // their own; the GM updates status / assigns a team.
      match /join_requests/{requestId} {
        allow read, write: if signedIn();
      }
    }

    match /submissions/{submissionId} {
      allow read, write: if signedIn();
    }

    // Side quest submissions (photo tallies, e.g. pothole reporting). Kept as
    // a separate top-level collection so the data can be exported for partners.
    match /side_quest_submissions/{submissionId} {
      allow read, write: if signedIn();
    }

    // Collection-group read for teams (cross-game team lookups).
    match /{path=**}/teams/{teamId} {
      allow read: if signedIn();
    }
  }
}
